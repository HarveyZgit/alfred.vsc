{
  "name": "vsc",
  "description": "An aflred workflow for finds recent vscode open records",
  "author": "Harvey Z",
  "version": "1.3.0",
  "main": "index.js",
  "license": "MIT",
  "dependencies": {
    "commander": "^9.3.0",
    "halfred-tools": "1.2.0",
    "lodash": "^4.17.21"
  },
  "scripts": {
    "t": "node --loader ts-node/esm",
    "build": "rm -rf build && node ./scripts/build.js",
    "updateWorkflow": "sh ./scripts/updateWorkflow.sh",
    "release": "pnpm build && VSC_RELEASE_MODE=1 sh ./scripts/release.sh",
    "release:dev": "pnpm build && VSC_RELEASE_MODE=0 sh ./scripts/release.sh"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^4.1.0",
    "@types/lodash": "^4.14.182",
    "@types/node": "^16",
    "rollup": "^2.70.2",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-module-replacement": "^1.2.1",
    "rollup-plugin-typescript2": "^0.31.2",
    "ts-node": "^10.7.0",
    "tslib": "^2.4.0",
    "typescript": "^4.6.3"
  }
}
